/* The interface in the friendly look of mockup/menus.html (Joro, 14.11.2026: "let's fix the look: the menus…";
   the menus are a proposal; Salamen asked for them in the game on 15.11.2026). The panel is 390 px wide, as the
   mockup, so its sizes are the mockup's. USS has no box shadows and no gradients: the shadow under a card is a
   thicker bottom edge, and the gradients are their middle colour.
   Ink #3b2618, edge #6b4226, panel #fffaf2, line #ecdcc6, soft #f6ead9, orange #ff8b3d, teal #22c19b, muted #9a7a62. */

.root { flex-grow: 1; color: #3b2618; font-size: 13px; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ic { background-size: 62% 62%; background-repeat: no-repeat no-repeat; background-position-x: center; background-position-y: center; flex-shrink: 0; }

/* the heavy weight of Nunito for numbers, names and buttons */
.ark-c, .atm-v, .pill-text, .db-l, .build-l, .bubble-nm, .sheet-title, .btn, .tag-text, .modal-title, .item-name, .card-name, .section, .db-dot, .ark-t {
    -unity-font-definition: initial; -unity-font: resource("Fonts/Nunito-900"); -unity-font-style: normal;
}

/* ---------- the top of the screen ---------- */
.top { position: absolute; left: 0; right: 0; top: 10px; height: 130px; }
.ark { position: absolute; top: 0; left: 12px; width: 66px; align-items: center; }
.ark-c { width: 64px; height: 64px; border-radius: 32px; background-color: #ff8b3d; border-width: 3px; border-color: #6b4226; border-bottom-width: 6px;
    color: #ffffff; font-size: 28px; -unity-text-align: middle-center; text-shadow: 0 2px 0 rgba(150, 60, 10, 0.5); padding: 0; }
.ark-t { margin-top: 3px; padding: 0 8px 1px 8px; height: 16px; -unity-text-align: middle-center; border-radius: 10px; background-color: #6b4226; color: #ffffff; font-size: 11px; letter-spacing: 0.3px; }
.crew { position: absolute; top: 88px; left: 12px; }
.atm { position: absolute; top: 4px; left: 90px; right: 12px; height: 34px; border-radius: 17px; flex-direction: row; align-items: center; padding: 0 12px 0 5px;
    background-color: #fffaf2; border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; }
.atm-ic { width: 24px; height: 24px; border-radius: 12px; margin-right: 8px; }
.atm-bar { flex-grow: 1; height: 12px; border-radius: 6px; background-color: #f1dfcb; margin-right: 8px; overflow: hidden; }
.atm-fill { height: 12px; border-radius: 6px; background-color: #3bcfa9; width: 0; }
.atm-v { font-size: 16px; margin: 0; padding: 0 0 2px 0; }
.atm-next { font-size: 11px; color: #9a7a62; margin-left: 2px; }
.res { position: absolute; top: 46px; left: 88px; right: 10px; flex-direction: row; }
.res2 { top: 88px; }
.pill { flex-direction: row; align-items: center; height: 32px; border-radius: 16px; padding: 0 3px 0 2px; margin-right: 4px; width: 70px;
    background-color: #fffaf2; border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; }
.pill.s { height: 28px; border-width: 2px; border-bottom-width: 4px; border-radius: 14px; padding: 0 7px 0 2px; }
.res2 .pill.s { width: 66px; }
.res2 .pill.wide { width: 86px; }
.crew.pill.s { width: auto; }
.pill-ic { width: 22px; height: 22px; border-radius: 11px; margin-right: 3px; }
.pill-ic.small { width: 20px; height: 20px; border-radius: 10px; }
.pill-text { font-size: 13px; margin: 0; padding: 0 0 2px 0; -unity-text-align: middle-left; }
.pill.s .pill-text { font-size: 12px; }
.pill-cap { display: none; }
.pill.full .pill-text { color: #e5533d; }
.energy-ok .pill-text { color: #189a7b; }
.energy-short .pill-text { color: #e5533d; }
.battery { width: 22px; height: 11px; border-radius: 3px; border-width: 2px; border-color: #3b2618; margin-left: 3px; padding: 1px; }
.battery-fill { height: 100%; background-color: #22c19b; border-radius: 1px; width: 0; }

/* ---------- the bar at the bottom ---------- */
.dock { position: absolute; left: 12px; right: 12px; bottom: 8px; height: 72px; border-radius: 26px; flex-direction: row; align-items: center; justify-content: space-around;
    padding: 0 8px; background-color: #fffaf2; border-width: 3px; border-color: #6b4226; border-bottom-width: 6px; }
.db { width: 58px; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; margin: 0; }
.db-c { width: 46px; height: 46px; border-radius: 23px; border-width: 3px; border-color: #ffffff; background-size: 50% 50%; }
.db-l { font-size: 10.5px; margin-top: 2px; color: #3b2618; }
.db-dot { display: none; position: absolute; right: 2px; top: -4px; min-width: 18px; height: 18px; border-radius: 9px; background-color: #ff5d5d; color: #ffffff;
    font-size: 11px; -unity-text-align: middle-center; border-width: 2px; border-color: #ffffff; padding: 0 3px; }
.db.glow .db-dot { display: flex; }
.build { width: 88px; margin-top: -40px; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; }
.build-c { width: 78px; height: 78px; border-radius: 39px; border-width: 4px; border-color: #6b4226; border-bottom-width: 7px; background-size: 64% 64%; }
.build-l { font-size: 14px; margin-top: 1px; color: #3b2618; }
.build.glow .build-c { border-color: #22c19b; }

/* ---------- ECHO speaks ---------- */
.echo-card { position: absolute; left: 12px; right: 12px; bottom: 122px; flex-direction: row; align-items: flex-start; border-radius: 18px; padding: 9px 12px 10px 8px;
    background-color: #fffaf2; border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; }
.who { width: 40px; height: 40px; border-radius: 20px; border-width: 3px; border-color: #6b4226; margin-right: 9px; background-size: 92% 92%; }
.bubble-col { flex-shrink: 1; flex-grow: 1; flex-direction: column; }
.bubble-nm { font-size: 11px; color: #22c19b; letter-spacing: 0.6px; }
.bubble-text { font-size: 14.5px; white-space: normal; color: #3b2618; }

/* ---------- a sheet from the bottom ---------- */
.sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 74%; background-color: #fffaf2; border-top-left-radius: 28px; border-top-right-radius: 28px;
    padding: 0 14px 22px 14px; border-width: 3px; border-bottom-width: 0; border-color: #6b4226; }
.grab { width: 44px; height: 5px; border-radius: 3px; background-color: #dcc6ac; margin: 7px 0 4px 0; align-self: center; flex-shrink: 0; }
.sheet-head { flex-direction: row; align-items: center; margin-bottom: 6px; flex-shrink: 0; }
.hi { width: 44px; height: 44px; border-radius: 22px; border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; margin-right: 10px; background-size: 52% 52%; }
.sheet-title { font-size: 21px; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.sheet-sub { font-size: 12px; color: #9a7a62; margin-bottom: 6px; white-space: normal; }
.close { width: 36px; height: 36px; border-radius: 18px; background-color: #ffffff; padding: 0; margin: 0;
    border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; background-size: 46% 46%; background-repeat: no-repeat no-repeat; background-position-x: center; background-position-y: center; }
.section { font-size: 11px; color: #9a7a62; letter-spacing: 0.8px; margin: 10px 2px 6px 2px; }
.line { flex-direction: row; align-items: center; justify-content: space-between; padding: 3px 0; }
.line-text { white-space: normal; flex-shrink: 1; }
.ok { color: #189a7b; }
.no { color: #e5533d; }
.muted { color: #9a7a62; }
.btn { background-color: #ff8b3d; color: #ffffff; border-radius: 23px; height: 46px; font-size: 16px; margin-top: 8px; padding: 0 16px;
    border-width: 3px; border-color: #6b4226; border-bottom-width: 6px; text-shadow: 0 1px 0 rgba(150, 60, 10, 0.4); }
.btn:hover { background-color: #ff9a4a; }
.btn:active { border-bottom-width: 3px; margin-top: 11px; }
.btn:disabled { background-color: #e9dccb; color: #a58f7a; border-color: #cdb79e; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.btn.small { height: 32px; font-size: 13px; margin: 2px; border-radius: 16px; padding: 0 13px; border-width: 2px; border-bottom-width: 4px; }
.btn.small:active { margin-top: 4px; border-bottom-width: 2px; }
.btn.alt { background-color: #6b4226; border-color: #3b2618; }
.btn.teal { background-color: #2ac4a0; border-color: #138a6c; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.btn.picked { background-color: #ffffff; color: #3b2618; border-color: #6b4226; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
/* a choice of one (what a miner digs, the seed, the tempo): the chosen one is white with an edge, the others quiet */
.btn.choice { background-color: #f6ead9; color: #9a7a62; border-color: #ecdcc6; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.btn.choice.picked { background-color: #ffffff; color: #3b2618; border-color: #6b4226; }
.row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.card { width: 23%; margin: 1%; background-color: #ffffff; border-radius: 14px; padding: 4px 3px 6px 3px; align-items: center; border-width: 2px; border-color: #ecdcc6; }
.card.can { border-color: #22c19b; border-width: 3px; background-color: #f2fffa; }
.card-img { width: 58px; height: 58px; border-radius: 12px; background-color: #f6ead9; align-items: center; justify-content: center; }
.card-lock { width: 24px; height: 24px; border-radius: 12px; background-color: #6b4226; color: #ffffff; -unity-text-align: middle-center; font-size: 11px; border-width: 2px; border-color: #ffffff; }
.card-name { font-size: 10.5px; -unity-text-align: middle-center; white-space: normal; margin-top: 3px; }
.card-info { font-size: 10px; color: #9a7a62; -unity-text-align: middle-center; white-space: normal; }
.bar { height: 8px; background-color: #f1dfcb; border-radius: 4px; margin: 3px 0; overflow: hidden; }
.bar-fill { height: 8px; background-color: #ff8a3a; border-radius: 4px; width: 0; }
.item { background-color: #ffffff; border-radius: 16px; padding: 9px 11px; margin-bottom: 6px; border-width: 2px; border-color: #ecdcc6; }
.item.done { opacity: 0.6; }
.item.rec { border-color: #22c19b; border-width: 3px; }
.item-name { font-size: 15px; }
.item-info { font-size: 12px; color: #9a7a62; white-space: normal; }

/* ---------- a card in the middle ---------- */
.dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(70, 38, 20, 0.5); align-items: center; justify-content: center; }
.modal { width: 88%; background-color: #fffaf2; border-radius: 26px; padding: 16px; border-width: 3px; border-color: #6b4226; border-bottom-width: 6px; }
.modal-title { font-size: 23px; margin-bottom: 4px; white-space: normal; -unity-text-align: middle-center; }
.modal-text { font-size: 14px; white-space: normal; margin: 4px 0; }
.quote { font-size: 14.5px; color: #3b2618; white-space: normal; margin: 10px 0; padding: 8px 11px; background-color: #f6ead9; border-left-width: 4px; border-color: #22c19b;
    border-top-right-radius: 12px; border-bottom-right-radius: 12px; }
.blueprint { height: 120px; background-color: #1d2442; border-radius: 12px; margin: 8px 0; }

/* ---------- tags over the map ---------- */
.tag { position: absolute; translate: -50% -100%; flex-direction: row; align-items: center; height: 30px; background-color: #ffffff; border-radius: 15px; padding: 0 9px 0 3px;
    border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; }
.tag-text { font-size: 13px; margin: 0; padding: 0 0 2px 0; -unity-text-align: middle-left; }
.tag-ic { width: 20px; height: 20px; border-radius: 10px; margin-right: 4px; background-size: 62% 62%; background-repeat: no-repeat no-repeat; background-position-x: center; background-position-y: center; }
.tag.bubble { border-color: #c2531c; background-color: #fff4e6; }
.tag.ready { background-color: #ff8b3d; padding: 0 11px; }
.tag.ready .tag-text { color: #ffffff; }
.tag.action { background-color: #2ac4a0; border-color: #138a6c; height: 40px; border-radius: 20px; padding: 0 18px; }
.tag.action .tag-text { color: #ffffff; font-size: 16px; }
.tag.timer { height: auto; padding: 3px 9px 5px 9px; flex-direction: column; align-items: stretch; min-width: 74px; }
.tag.timer .tag-text { font-size: 11.5px; -unity-text-align: middle-center; }
.tag.timer .bar { height: 5px; }
.arrow { position: absolute; translate: -50% -100%; width: 0; height: 0; border-left-width: 12px; border-right-width: 12px; border-top-width: 18px;
    border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: #ff8b3d; }

.dev-btn { position: absolute; left: 14px; top: 136px; width: 30px; height: 30px; border-radius: 15px; background-color: rgba(107, 66, 38, 0.55); color: #fffaf2; font-size: 10px;
    padding: 0; border-width: 0; }
.toast { position: absolute; left: 18%; right: 18%; top: 40%; background-color: #fffaf2; color: #3b2618; border-radius: 16px; padding: 9px; -unity-text-align: middle-center;
    white-space: normal; border-width: 3px; border-color: #6b4226; border-bottom-width: 5px; }
