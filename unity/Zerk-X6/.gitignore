/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Meta files are kept (they hold the asset GUIDs).
!/[Aa]ssets/**/*.meta

# IDE and solution files, made by the editor of each computer
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
